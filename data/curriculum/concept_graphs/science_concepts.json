  "ngss_practices": {
    "practice_1": {
      "name": "Asking Questions and Defining Problems",
      "description": "Scientists ask questions, engineers define problems",
      "k2_examples": ["What do plants need to grow?", "Why does ice melt?"],
      "35_examples": ["How do adaptations help animals survive?", "What causes day and night?"]
    },
    "practice_2": {
      "name": "Developing and Using Models",
      "description": "Models represent ideas and phenomena",
      "k2_examples": ["Draw life cycle of butterfly", "Model of animal habitat"],
      "35_examples": ["Food web diagram", "Water cycle model", "Solar system model"]
    },
    "practice_3": {
      "name": "Planning and Carrying Out Investigations",
      "description": "Design and conduct scientific investigations",
      "k2_examples": ["Test which materials sink or float", "Observe plant growth"],
      "35_examples": ["Investigate how force affects motion", "Test soil types for plant growth"]
    },
    "practice_4": {
      "name": "Analyzing and Interpreting Data",
      "description": "Make sense of data to find patterns",
      "k2_examples": ["Count and compare animal types", "Record daily weather"],
      "35_examples": ["Graph temperature changes", "Analyze ecosystem data"]
    },
    "practice_5": {
      "name": "Using Mathematics and Computational Thinking",
      "description": "Use math to analyze and present data",
      "k2_examples": ["Measure and compare lengths", "Count objects in groups"],
      "35_examples": ["Calculate force and motion", "Use measurements in investigations"]
    },
    "practice_6": {
      "name": "Constructing Explanations and Designing Solutions",
      "description": "Use evidence to explain phenomena or solve problems",
      "k2_examples": ["Explain why animals need food", "Design shelter for animal"],
      "35_examples": ["Explain weathering and erosion", "Design solution to reduce erosion"]
    },
    "practice_7": {
      "name": "Engaging in Argument from Evidence",
      "description": "Support claims with evidence",
      "k2_examples": ["Argue which material is best for purpose", "Support claim with observations"],
      "35_examples": ["Debate environmental impacts", "Support claims about adaptations"]
    },
    "practice_8": {
      "name": "Obtaining, Evaluating, and Communicating Information",
      "description": "Read, interpret, and share scientific information",
      "k2_examples": ["Share observations", "Listen to information about animals"],
      "35_examples": ["Research and present findings", "Evaluate sources of information"]
    }
  },
  "crosscutting_concepts": {
    "patterns": {
      "name": "Patterns",
      "description": "Patterns in nature can be observed and used to make predictions",
      "examples": ["Day/night pattern", "Seasons pattern", "Life cycle patterns"]
    },
    "cause_effect": {
      "name": "Cause and Effect",
      "description": "Events have causes that can be identified",
      "examples": ["Pushing causes motion", "Water causes erosion", "No water causes plants to wilt"]
    },
    "scale": {
      "name": "Scale, Proportion, and Quantity",
      "description": "Size, scale, and quantity matter in science",
      "examples": ["Comparing animal sizes", "Solar system scale", "Measuring matter"]
    },
    "systems": {
      "name": "Systems and System Models",
      "description": "Systems have parts that work together",
      "examples": ["Ecosystems", "Water cycle", "Body systems"]
    },
    "energy_matter": {
      "name": "Energy and Matter",
      "description": "Energy and matter flow through systems",
      "examples": ["Food chains show energy flow", "Water cycle shows matter cycling"]
    },
    "structure_function": {
      "name": "Structure and Function",
      "description": "Shape and structure relate to function",
      "examples": ["Bird beaks adapted to food", "Roots absorb water", "Wheels reduce friction"]
    },
    "stability_change": {
      "name": "Stability and Change",
      "description": "Systems can be stable or change over time",
      "examples": ["Seasons change", "Habitats change", "Matter changes state"]
    }
  }

# EduLens Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Choose your LLM provider: anthropic, openai, google, deepseek, azure_openai, ollama
LLM_PROVIDER=deepseek

# Model name (optional - uses provider default if not set)
# LLM_MODEL=deepseek-chat

# Vision model for DeepSeek live camera tutoring (experimental vision model)
# DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# Live tutoring observation tuning
# EDULENS_OBSERVATION_INTERVAL=12   # seconds between vision checks
# EDULENS_INTERVENTION_COOLDOWN=45  # min seconds between interventions

# =============================================================================
# API Keys (set the one for your chosen provider)
# =============================================================================

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI
# OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini
# GOOGLE_API_KEY=your-google-api-key-here

# DeepSeek
# DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-api-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# =============================================================================
# Application Settings
# =============================================================================

# Environment: development, staging, production
EDULENS_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR
EDULENS_LOG_LEVEL=INFO

# API server
EDULENS_API_HOST=0.0.0.0
EDULENS_API_PORT=8000

# =============================================================================
# Security (generate secure random values for production)
# =============================================================================

# Secret key for JWT tokens (use: openssl rand -hex 32)
# SECRET_KEY=your-secret-key-here

# Encryption key for data at rest (use: openssl rand -hex 32)
# ENCRYPTION_KEY=your-encryption-key-here
